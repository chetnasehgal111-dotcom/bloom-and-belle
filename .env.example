# ==============================================================================
# Bloom & Belle — Environment Variables Example
# Duplicate this file to .env.local for local development.
# ==============================================================================

# Public Website URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# WhatsApp Styling Concierge (Indian / International format without +)
NEXT_PUBLIC_WHATSAPP_NUMBER=919876543210

# Support Email
NEXT_PUBLIC_SUPPORT_EMAIL=care@bloomandbelle.in

# Email Marketing / Newsletter Service (Optional / Future production integrations)
# Form provider API keys: e.g. RESEND_API_KEY, MAILCHIMP_API_KEY, KLAVIYO_API_KEY
# RESEND_API_KEY=re_your_api_key_here
# CONTACT_RECIPIENT_EMAIL=inquiries@bloomandbelle.in

# Analytics & Meta Pixel (Optional for D2C ad tracking)
# NEXT_PUBLIC_META_PIXEL_ID=your_pixel_id_here
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
